---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroVideo from "./HeroVideo.astro";
import ReleaseAction from "../ui/ReleaseAction.astro";
import type { Locale } from "../../config/site";
import { releaseChannel } from "../../config/release";
import { landingSections } from "./sections";
import { useTranslations } from "../../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const page = t.pages.home;
const de = locale === "de";
const softwareApplicationData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Cozy Paint Studio",
  applicationCategory: "GraphicsApplication",
  operatingSystem: "Windows",
  url: releaseChannel.storeUrl,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "EUR",
    description: de ? "Während der Vorschauphase kostenlos" : "Free while the app is in preview",
  },
};
---

<BaseLayout {locale} route="home" title={page.title} description={page.description}>
  <script type="application/ld+json" set:html={JSON.stringify(softwareApplicationData)} />
  <section class="landing-hero section-space">
    <div class="hero-copy">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.heading}</h1>
      <p class="lead">{page.intro}</p>
      <div class="action-row">
        <ReleaseAction {locale} />
      </div>
      <p class="availability">
        {de ? "Android und iOS kommen bald." : "Android and iOS will come soon."}
      </p>
      <p class="maker-line">
        {de
          ? "Unabhängig entwickelt von Johannes Vollmer — Ölmaler, Designer und professioneller Softwareentwickler."
          : "Independently built by Johannes Vollmer—oil painter, designer, and professional software engineer."}
      </p>
    </div>
    <figure class="hero-visual">
      <HeroVideo {locale} />
    </figure>
  </section>
  {landingSections.map(({ id, className, Content, After }) => (
    <>
      <section {id} class={className} data-nav-section>
        <Content {locale} />
      </section>
      {After && <After {locale} />}
    </>
  ))}

  <section class="final-cta section-space halftone-surface">
    <p class="eyebrow">Cozy Paint Studio</p>
    <h2>{de ? "Mach die erste Linie." : "Make the first mark."}</h2>
    <p>
      {de
        ? "Cozy Paint Studio ist jetzt als kostenlose Vorschau im Microsoft Store verfügbar."
        : "Cozy Paint Studio is now available as a free preview from Microsoft Store."}
    </p>
    <div class="action-row">
      <ReleaseAction {locale} />
    </div>
  </section>
</BaseLayout>
