{
  "name": "cozy-paint-studio-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "check": "astro check",
    "format": "oxfmt . && prettier --write \"src/**/*.astro\"",
    "format:check": "oxfmt --check . && prettier --check \"src/**/*.astro\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "node --test tests/**/*.test.mjs",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run check",
    "preview": "astro preview"
  },
  "dependencies": {
    "@fontsource/iosevka-charon-mono": "5.3.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.18.3"
}
