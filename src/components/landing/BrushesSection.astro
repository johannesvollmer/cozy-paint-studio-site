---
import BrushCode from "./BrushCode.astro";
import type { Locale } from "../../config/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const de = locale === "de";
const examples = [
  {
    file: "round.wgsl",
    caption: de ? "Rund · eine klare Kante" : "Round · a crisp edge",
    code: `// A simple round brush.
fn shade(stamp: Stamp) -> vec4f {
  let inside = length(stamp.local_position) < 1.0;

  if inside {
    return stamp.color;
  }
  return vec4f(0.0);
}`,
  },
  {
    file: "textured.wgsl",
    caption: de ? "Textur · ein eigener Pinselabdruck" : "Texture · your own brush tip",
    code: `// Paint with a textured tip.
fn shade(stamp: Stamp) -> vec4f {
  let texture = sampleTexture(stamp.local_position);
  let opacity = texture.a * stamp.color.a;

  return vec4f(stamp.color.rgb, opacity);
}`,
  },
  {
    file: "dry.wgsl",
    caption: de ? "Trocken · Farbe trifft Körnung" : "Dry · paint catches the grain",
    code: `// Press harder to fill the grain.
fn shade(stamp: Stamp) -> vec4f {
  let grain = sampleGrain(stamp.canvas_position);

  if grain + stamp.pressure >= 1.0 {
    return stamp.color;
  }
  return vec4f(0.0);
}`,
  },
];
---

<header class="section-heading">
  <div class="brush-heading-copy">
    <p class="eyebrow">{de ? "Pinsel-Engines" : "Brush engines"}</p>
    <h2>
      {de
        ? "Jeder Pinsel kann anders programmiert werden."
        : "Each brush can be programmed differently."}
    </h2>
  </div>
  <div class="brush-intro">
    <p>
      {de
        ? "Ein Pinsel ist nicht bloß ein Stempel aus Texturen. Seine Engine kann mit eigenem Rendering-Code auf Druck, Form, Textur, Farbe, Abstand und Drehung reagieren."
        : "A brush is not merely a stamp made from textures. Its engine can use its own rendering code to respond to pressure, shape, texture, color, spacing, and rotation."}
    </p>
    <p class="brush-formula-note">
      {de
        ? "Eine klare Kante, ein strukturierter Abdruck oder Farbe, die in der Körnung hängen bleibt: Schon eine kleine Idee kann einen ganz eigenen Pinsel ergeben. Oder lass eine KI einen einzigartigen Pinsel nur für dich programmieren! Die KI wird aber nie für dich malen ;)"
        : "A crisp edge, a textured tip, or paint catching the canvas grain: even a small idea can give a brush its own character. Or let AI code up a unique brush just for you! It will never paint for you though ;)"}
    </p>
  </div>
</header>
<div
  class="brush-table"
  aria-label={de ? "Auszüge aus dem Pinsel-Shader" : "Brush shader excerpts"}
>
  {examples.map(({ file, caption, code }) => (
    <figure>
      <div class="code-card">
        <div class="code-card__bar">
          <span>{file}</span>
          <i></i>
          <i></i>
          <i></i>
        </div>
        <BrushCode code={code} />
      </div>
      <figcaption>{caption}</figcaption>
    </figure>
  ))}
</div>
