---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  locale="en"
  route="home"
  title="Page not found — Cozy Paint Studio"
  description="The requested Cozy Paint Studio page could not be found."
  canonicalPath="/404.html"
  includeAlternates={false}
  noindex
>
  <section class="not-found section-space">
    <div>
      <p class="eyebrow">404 / Outside the canvas</p>
      <h1>This mark went off-canvas.</h1>
      <p class="lead">
        There is nothing painted at this address. The canvas is still waiting at home.
      </p>
      <a class="button button--primary" href="/">
        Return to Cozy Paint Studio
      </a>
    </div>
    <div lang="de">
      <p class="eyebrow">404 / Außerhalb der Leinwand</p>
      <h2>Diese Linie ging daneben.</h2>
      <p>Unter dieser Adresse ist nichts gemalt. Die Leinwand wartet noch auf der Startseite.</p>
      <a href="/de/">Zur deutschen Startseite</a>
    </div>
  </section>
</BaseLayout>
