---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroVideo from "./HeroVideo.astro";
import ZoomDemoVideo from "./ZoomDemoVideo.astro";
import ReleaseAction from "../ui/ReleaseAction.astro";
import { Image } from "astro:assets";
import {
  appCanvasLandscape,
  appCanvasPortrait,
  appCanvasTall,
  brushSelectionFull,
  colorPickerColor,
  colorPickerLuminance,
} from "../../assets/screenshots";
import type { Locale } from "../../config/site";
import { releaseChannel } from "../../config/release";
import { routeFor } from "../../i18n/routes";
import { useTranslations } from "../../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const page = t.pages.home;
const de = locale === "de";
const benefits = de
  ? [
      [
        "Steht dir nicht im Weg",
        "Jetzt malen. Die Auflösung später wählen.",
        "Das ist der eigentliche Gewinn der grenzenlosen Leinwand: Du musst dich am Anfang nicht auf Breite, Höhe oder DPI festlegen. Fang einfach mit dem Bild an und entscheide dich erst dann für eine Auflösung, wenn du sie brauchst.",
      ],
      [
        "Geringe Latenz ist ein Merkmal",
        "Tinte nah am Stift.",
        "Immer reaktionsschnell, unabhängig von Zoomstufe oder Auflösung. Unmittelbares Malen ist unser Versprechen.",
      ],
      [
        "Malen vor Papierkram",
        "Dein Studio öffnet sich bereit für den ersten Strich.",
        "Cozy Paint Studio überspringt den Dialog zur Leinwandgröße, damit du sofort zeichnen kannst. Weitere Studiowerkzeuge entstehen noch.",
      ],
    ]
  : [
      [
        "Gets out of your way",
        "Paint now. Choose resolution later.",
        "That is the real win of an infinite canvas: no width, height, or DPI decision before the first mark. Start with the painting and choose a resolution only when you need one.",
      ],
      [
        "Low latency is a feature",
        "Ink close to the pen.",
        "Always responsive, no matter the zoom or resolution. Immediate painting is our promise.",
      ],
      [
        "Painting before paperwork",
        "Your studio opens ready for a mark.",
        "Cozy Paint Studio skips the canvas-size dialog so you can start drawing immediately. More studio tools are still being built.",
      ],
    ];
---

<BaseLayout {locale} route="home" title={page.title} description={page.description}>
  <section class="landing-hero section-space">
    <div class="hero-copy">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.heading}</h1>
      <p class="lead">{page.intro}</p>
      <div class="action-row">
        <ReleaseAction {locale} />
      </div>
      <p class="availability">
        {de
          ? "Für Tablets entworfen. Zuerst für Windows; iPad, vielleicht macOS und später Android sind Richtungen, keine aktuellen Downloads."
          : "Designed for tablets. Windows first; iPad, perhaps macOS, and later Android are directions, not current downloads."}
      </p>
      <p class="maker-line">
        {de
          ? "Unabhängig entwickelt von Johannes Vollmer — Ölmaler, Designer und professioneller Softwareentwickler."
          : "Independently built by Johannes Vollmer—oil painter, designer, and professional software engineer."}
      </p>
    </div>
    <figure class="hero-visual">
      <HeroVideo {locale} />
    </figure>
  </section>
  <section id="why-cozy" class="statement section-space content-grid">
    <p class="section-index">01 / {de ? "Der Unterschied" : "The difference"}</p>
    <div>
      <h2>
        {de
          ? "Die fehlende Mitte zwischen Pixel und Vektor."
          : "The missing middle between pixel and vector."}
      </h2>
      <p class="lead">
        {de
          ? "Pixelbilder bestehen aus einem einzigen großen Raster: einem festen Gitter aus Farbwerten. Vektorbilder sind dagegen eine Liste aus einfachen Formen und Kurven mit Strichstärke, die in jeder Auflösung gerendert werden können."
          : "Pixel images are one large raster: a fixed grid of color values. Vector images are a list of simple shapes and curves with thickness, which can be rendered at any resolution."}
      </p>
      <p class="lead">
        {de
          ? "Cozy Paint Studio etabliert einen neuen grundlegenden Bildtyp zwischen diesen beiden. Ein Bild wird durch beliebige Formeln pro Pixel beschrieben, die in jeder Auflösung ausgewertet werden können. Eine Formel kann Rasterbilder abtasten, Schleifen ausführen oder beim Auswerten jedes Pixels beliebige Formen erzeugen. So kann sie ein Fraktal oder eine Unschärfe rendern — oder dynamisch auf Stiftdruck, Winkel, Neigung, Strichstärke, Strichfarbe und mehr reagieren."
          : "Cozy Paint Studio establishes a new fundamental image type between the two. An image is described by arbitrary per-pixel formulas that can be evaluated at any resolution. A formula can sample raster images, run loops, or generate arbitrary shapes as it evaluates each pixel. It can render a fractal or a blur, or change its result dynamically with pen pressure, angle, tilt, stroke thickness, stroke color, and more."}
      </p>
    </div>
    <figure class="difference-visual">
      <ZoomDemoVideo {locale} />
    </figure>
  </section>

  <section
    class="benefits section-space"
    aria-label={de ? "Drei Kernvorteile" : "Three core benefits"}
  >
    {benefits.map(([label, heading, body], index) => (
      <article class="benefit">
        <span class="benefit-number">0{index + 1}</span>
        <p class="eyebrow">{label}</p>
        <h2>{heading}</h2>
        <p>{body}</p>
      </article>
    ))}
  </section>

  <section class="feature-section interaction-section section-space feature-layout">
    <figure class="interface-visual">
      <Image
        src={brushSelectionFull}
        alt={
          de
            ? "Ein gemalter roter Apfel mit der direkt auf der Leinwand geöffneten Pinselauswahl"
            : "A painted red apple with the brush selection open directly on the canvas"
        }
        format="webp"
        quality={62}
        width={1200}
        widths={[640, 960, 1200, 1600]}
        sizes="(max-width: 56rem) 100vw, 58vw"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="feature-copy">
      <p class="eyebrow">{de ? "Stift + Berührung" : "Pen + touch"}</p>
      <h2>{de ? "Regler, direkt unter dem Stift." : "Sliders, right under your pen."}</h2>
      <p class="lead">
        {de
          ? "Halte eine Pinseleigenschaft und ihre Einstellung erscheint unter dem Stift. Lege Favoriten an den Tablet-Rand und erreiche kürzlich genutzte Pinsel mit einer radialen Geste."
          : "Hold a brush control and its adjustment appears beneath the pen. Keep favorite properties on the tablet edge and reach for a recent brush with a radial gesture."}
      </p>
    </div>
  </section>

  <section class="color-section section-space feature-layout">
    <div class="feature-copy">
      <p class="eyebrow">{de ? "Farbe auf der Leinwand" : "Color on canvas"}</p>
      <h2>
        {de
          ? "Farben dort, wo die Augen sind — direkt auf dem Bild."
          : "Colors where the eyes are—right on the painting."}
      </h2>
      <p class="lead">
        {de
          ? "Drücke die Farbtaste und der Oklab-Farbwähler erscheint direkt unter dem Stift. Du vergleichst die nächste Farbe mit dem Bild, statt den Blick in eine abgetrennte Seitenleiste zu schicken."
          : "Press the color control and the Oklab picker appears directly beneath the pen. Compare the next color with the painting itself instead of sending your eyes to an isolated pane on the right."}
      </p>
    </div>
    <div class="color-picker-visual">
      <figure>
        <Image
          src={colorPickerColor}
          alt={
            de
              ? "Farbwähler von Cozy Paint Studio direkt über einem gemalten roten Apfel"
              : "Cozy Paint Studio color picker directly over a painted red apple"
          }
          format="webp"
          quality={50}
          width={720}
          widths={[360, 540, 720, 960]}
          sizes="(max-width: 56rem) 48vw, 31vw"
          loading="lazy"
          decoding="async"
        />
        <figcaption>{de ? "Farbe" : "Color"}</figcaption>
      </figure>
      <figure>
        <Image
          src={colorPickerLuminance}
          alt={
            de
              ? "Kreisförmiger Farbwähler von Cozy Paint Studio direkt über einem gemalten roten Apfel"
              : "Cozy Paint Studio circular color picker directly over a painted red apple"
          }
          format="webp"
          quality={50}
          width={720}
          widths={[360, 540, 720, 960]}
          sizes="(max-width: 56rem) 48vw, 31vw"
          loading="lazy"
          decoding="async"
        />
        <figcaption>{de ? "Helligkeit" : "Lightness"}</figcaption>
      </figure>
    </div>
  </section>

  <section id="brushes" class="brush-section section-space">
    <div class="section-heading">
      <p class="eyebrow">{de ? "Pinsel-Engines" : "Brush engines"}</p>
      <h2>{de ? "Ein Pinsel ist programmierbar." : "A brush can be programmed."}</h2>
      <p>
        {de
          ? "Ein Pinsel ist nicht bloß ein Stempel aus Texturen. Seine Engine kann mit eigenem Rendering-Code auf Druck, Form, Textur, Farbe, Abstand und Drehung reagieren."
          : "A brush is not merely a stamp made from textures. Its engine can use its own rendering code to respond to pressure, shape, texture, color, spacing, and rotation."}
      </p>
    </div>
    <div
      class="brush-table"
      aria-label={de ? "Illustrative Pinselspuren" : "Illustrative brush marks"}
    >
      <figure>
        <span class="swatch swatch--pencil"></span>
        <figcaption>{de ? "Bleistift · Druckbreite" : "Pencil · pressure width"}</figcaption>
      </figure>
      <figure>
        <span class="swatch swatch--paint"></span>
        <figcaption>{de ? "Farbe · Relief" : "Paint · relief"}</figcaption>
      </figure>
      <figure>
        <span class="swatch swatch--polygon"></span>
        <figcaption>{de ? "Polygon · Kanten" : "Polygon · edges"}</figcaption>
      </figure>
    </div>
    <p class="future-note">
      <strong>{de ? "Die Richtung:" : "The direction:"}</strong>{" "}
      {de
        ? "Austauschbare Pakete aus Pinselmodellen, Vorgaben und Texturen. Noch nicht zum Download verfügbar."
        : "Exchangeable packs of brush models, presets, and textures. Not available to download yet."}
    </p>
    <p class="scope-note">
      <strong>{de ? "Bewusster Fokus:" : "A deliberate focus:"}</strong>{" "}
      {de
        ? "Das geplante nasse Malen soll Farben überzeugend auf der Leinwand mischen. Es ist kein Versprechen, jede physikalische Eigenschaft echter Farbe zu simulieren."
        : "The planned wet-painting tool is intended to mix colors convincingly on the canvas. It is not a promise to simulate every physical property of real paint."}
    </p>
  </section>

  <section id="story" class="founder-section section-space content-grid">
    <div class="founder-aside">
      <p class="section-index">02 / {de ? "Meine Geschichte" : "My story"}</p>
      <p class="founder-signature">Johannes Vollmer</p>
    </div>
    <div class="founder-copy">
      <h2>
        {de
          ? "Das ist die Mal-App, die ich seit meinem zwölften Lebensjahr bauen wollte."
          : "This is the painting app I have wanted since I was twelve."}
      </h2>
      <p class="lead">
        {de
          ? "Hallo, ich bin Johannes. Als Kind Photoshop und Blender zu lernen, führte mich zu Grafikprogrammierung, generativer Kunst, UX-Design und schließlich in die professionelle Softwareentwicklung. Abseits vom Bildschirm male ich mit Öl."
          : "Hi, I’m Johannes. Learning Photoshop and Blender as a kid led me into graphics programming, generative art, UX design, and eventually professional software engineering. Away from the screen, I paint in oils."}
      </p>
      <p class="lead">
        {de
          ? "Als ich Mischief zum ersten Mal ausprobierte, fühlte sich digitales Malen ungewöhnlich direkt und frei an. Als es eingestellt wurde, blieb dieses Gefühl bei mir. Ich wollte die Idee weiterführen — aber mit strukturierten, farbigen Pinseln, die sich wie vollständige Instrumente verhalten können statt wie einfache Vektorspuren."
          : "When I first tried Mischief, digital painting felt unusually direct and free. When it was discontinued, that feeling stayed with me. I wanted to carry the idea forward—but with textured, colored brushes that could behave like complete instruments rather than simple vector marks."}
      </p>
      <p class="lead">
        {de
          ? "Cozy Paint Studio ist das Ergebnis. Ich entwickle es unabhängig und in meiner Freizeit als das fokussierte Malwerkzeug, das ich selbst benutzen möchte. Es ist kein venture-finanzierter Versuch, die nächste Kreativplattform zu bauen. Es ist meine Traum-App."
          : "Cozy Paint Studio is the result. I am building it independently, in my free time, as the focused painting tool I want to use myself. It is not a venture-backed attempt to build another creative-software platform. It is my dream app."}
      </p>
      <aside class="studio-note">
        <p class="eyebrow">{de ? "Wie es entsteht" : "How it is built"}</p>
        <p>
          {de
            ? "Ich nutze bei der Entwicklung von Cozy Paint Studio auch KI-Werkzeuge. Sie beschleunigen Teile der Arbeit. Produktrichtung, Architektur, Interaktionsdesign und die finalen technischen Entscheidungen liegen bei mir und bauen auf meiner professionellen 15-jährigen Erfahrung in Softwareentwicklung und UX Design auf. Ich übernehme die volle Verantwortung für diese Software."
            : "I use AI-assisted development tools while building Cozy Paint Studio. They accelerate parts of the work. I own the product direction, architecture, interaction design, and final engineering decisions, grounded in my 15+ years of professional software engineering and UX design experience. I take full responsibility for this software."}
        </p>
      </aside>
    </div>
  </section>

  <section class="projects-section section-space content-grid">
    <div>
      <p class="eyebrow">{de ? "Projektwand" : "Project wall"}</p>
      <h2>{de ? "Finde das Bild, indem du es siehst." : "Find the painting by seeing it."}</h2>
      <p class="lead">
        {de
          ? "Cozy Paint Studio öffnet sich auf einer Wand aus Arbeiten. Das Bild – nicht ein erzeugter Dateiname – ist die Identität, nach der du greifst."
          : "Cozy Paint Studio opens onto a wall of work. The image—not a generated file name—is the identity you reach for."}
      </p>
    </div>
    <div class="project-wall" aria-hidden="true">
      <figure>
        <Image src={appCanvasPortrait} alt="" format="webp" quality={45} width={520} />
      </figure>
      <figure>
        <Image src={appCanvasLandscape} alt="" format="webp" quality={45} width={520} />
      </figure>
      <figure>
        <Image src={appCanvasTall} alt="" format="webp" quality={45} width={520} />
      </figure>
      <span class="new-project">+</span>
    </div>
  </section>

  <section class="windows-section section-space content-grid">
    <p class="section-index">{de ? "Windows zuerst" : "Windows first"}</p>
    <div>
      <h2>
        {de ? "Auf Glas geboren. Beginnend auf Windows." : "Born on glass. Beginning on Windows."}
      </h2>
      <p class="lead">
        {de
          ? "Die Oberfläche wurde für Stift, berührungsgroße Bedienelemente und die Reichweite zweier Hände auf einem Tablet entworfen. Zuerst soll die Windows-Version richtig funktionieren."
          : "The interface was designed around a stylus, touch-sized controls, and the reach of two hands on a tablet. The first goal is to make the Windows version work well."}
      </p>
    </div>
  </section>

  <section id="roadmap" class="roadmap-section section-space">
    <header class="roadmap-heading">
      <p class="section-index">{de ? "Roadmap / ohne Termine" : "Roadmap / no dates"}</p>
      <div>
        <h2>{de ? "Eine Richtung, kein Zeitplan." : "A direction, not a timeline."}</h2>
        <p class="lead">
          {de
            ? "Diese Roadmap ist eine lose Sammlung der nächsten großen Themen. Die Reihenfolge zeigt die heutige Priorität, nicht feste Zusagen oder Veröffentlichungstermine. Sie kann sich mit der Entwicklung und dem Feedback von Malerinnen und Malern ändern."
            : "This roadmap is a loose collection of the next big things. The order reflects today’s priorities, not commitments or release dates, and may change as the app develops and painters weigh in."}
        </p>
      </div>
    </header>

    <div class="roadmap-now" aria-label={de ? "Was jetzt funktioniert" : "What works now"}>
      <p class="eyebrow">{de ? "Funktioniert jetzt" : "Working now"}</p>
      <ul>
        <li>{de ? "Zeichnen" : "Drawing"}</li>
        <li>{de ? "Eigene Pinsel" : "Custom brushes"}</li>
        <li>{de ? "Eigene Pinseltexturen" : "Custom brush textures"}</li>
        <li>
          {de ? "Grenzenlose Leinwand & skalierbare Pinsel" : "Infinite canvas & scalable brushes"}
        </li>
        <li>{de ? "Unbegrenztes Rückgängigmachen & Wiederholen" : "Unlimited undo & redo"}</li>
        <li>{de ? "Lokal gespeicherte Pinselvorgaben" : "Locally saved brush presets"}</li>
        <li>{de ? "Automatisch gespeichert nach jedem Strich" : "Autosaved after every stroke"}</li>
      </ul>
    </div>

    <div class="roadmap-grid">
      <div class="roadmap-priorities">
        <p class="eyebrow">{de ? "Große Funktionsprioritäten" : "Big feature priorities"}</p>
        <ol class="priority-list">
          <li>
            <span>01</span>
            <div>
              <h3>{de ? "Lasso: auswählen & malen" : "Lasso select & paint"}</h3>
              <p>
                {de
                  ? "Einen Bereich frei umreißen und das Malen darauf begrenzen."
                  : "Draw a freeform selection and keep painting inside it."}
              </p>
            </div>
          </li>
          <li>
            <span>02</span>
            <div>
              <h3>{de ? "Verschieben, skalieren & drehen" : "Move, scale & rotate"}</h3>
              <p>
                {de
                  ? "Bildbereiche mit einem Lasso oder Pinsel auswählen und transformieren."
                  : "Select parts of a painting with a lasso or brush, then transform them."}
              </p>
            </div>
          </li>
          <li>
            <span>03</span>
            <div>
              <h3>{de ? "Konfigurierbare Tastenkürzel" : "Configurable keybindings"}</h3>
              <p>
                {de
                  ? "Tastaturbefehle an den eigenen Arbeitsablauf anpassen."
                  : "Adapt keyboard commands to your own workflow."}
              </p>
            </div>
          </li>
          <li>
            <span>04</span>
            <div>
              <h3>{de ? "Nasses Malen" : "Wet painting"}</h3>
              <p>
                {de
                  ? "Farben direkt auf der Leinwand mischen — eher wie Ölfarbe."
                  : "Mix colors directly on the canvas, more like working in oils."}
              </p>
            </div>
          </li>
          <li>
            <span>05</span>
            <div>
              <h3>{de ? "Ebenen" : "Layers"}</h3>
              <p>
                {de
                  ? "Bildelemente getrennt organisieren und bearbeiten."
                  : "Organize and edit parts of a painting separately."}
              </p>
            </div>
          </li>
          <li>
            <span>06</span>
            <div>
              <h3>{de ? "Rahmen für Rasterexport" : "Frames for raster export"}</h3>
              <p>
                {de
                  ? "Auf der grenzenlosen Leinwand festlegen, welcher Ausschnitt in welcher Auflösung exportiert wird."
                  : "Define which part of the endless canvas exports, and at what resolution."}
              </p>
            </div>
          </li>
          <li>
            <span>07</span>
            <div>
              <h3>
                {de
                  ? "Pinsel-Engines & Texturpakete aus der Community"
                  : "Community brush engines & texture packs"}
              </h3>
              <p>
                {de
                  ? "Pinsel und Texturen als vollständige kreative Werkzeuge austauschen."
                  : "Exchange brushes and textures as complete creative tools."}
              </p>
            </div>
          </li>
        </ol>
        <p class="performance-note">
          <strong>{de ? "Außerdem geplant:" : "Also planned:"}</strong>{" "}
          {de
            ? "Verschiedene Performance-Optimierungen sind vorgesehen, vorerst aber aufgeschoben, während die Kernwerkzeuge Vorrang haben."
            : "Various performance optimizations are planned, but postponed for now while the core tools take priority."}
        </p>
      </div>

      <aside class="platform-path">
        <p class="eyebrow">{de ? "Plattformrichtung" : "Platform direction"}</p>
        <ol>
          <li>
            <span>{de ? "Zuerst" : "First"}</span>
            <strong>Windows</strong>
            <p>
              {de ? "Die erste voll funktionsfähige Version." : "The first fully working version."}
            </p>
          </li>
          <li>
            <span>{de ? "Danach" : "Then"}</span>
            <strong>iPad {de ? "und vielleicht macOS" : "and perhaps macOS"}</strong>
            <p>
              {de
                ? "Apple-Versionen können folgen, sobald Windows steht."
                : "Apple versions can follow once Windows is in good shape."}
            </p>
          </li>
          <li>
            <span>{de ? "Später" : "Later"}</span>
            <strong>Android</strong>
            <p>
              {de
                ? "Dafür brauche ich zuerst ein Android-Tablet mit Stift zum Entwickeln und Testen."
                : "That starts with getting an Android tablet with a stylus for development and testing."}
            </p>
          </li>
        </ol>
      </aside>
    </div>
  </section>

  <section class="preview-disclosure section-space content-grid">
    <p class="eyebrow">{releaseChannel.label[locale]}</p>
    <div>
      <h2>
        {de
          ? "Ein funktionierendes Studio, das noch gebaut wird."
          : "A working studio, still being built."}
      </h2>
      <p>{releaseChannel.disclosure[locale]}</p>
      <aside class="compatibility-warning">
        <p>
          <strong>{de ? "Wichtig zu deinen Dateien:" : "Important about your files:"}</strong>{" "}
          {de
            ? "Zeichnungen aus diesem Prototyp lassen sich möglicherweise in keiner späteren Version öffnen — nicht einmal im nächsten Prototyp und mit großer Sicherheit nicht in der fertigen Version. Wir versprechen, die alten ausführbaren Dateien verfügbar zu halten, damit du alte Zeichnungen immer mit der jeweils alten Studio-Version öffnen kannst."
            : "Drawings made with this prototype may not open in any later version—not even the next prototype, and almost certainly not the finished version. We promise to keep the old executables available, so you can always open old drawings with the matching old Studio."}
        </p>
      </aside>
      <p>
        <a href={routeFor("support", locale)}>
          {de ? "Support und Hinweise für Fehlerberichte" : "Support and reporting guidance"}
        </a>
      </p>
    </div>
  </section>

  <section id="community" class="community-section section-space content-grid">
    <div>
      <p class="eyebrow">Community</p>
      <h2>
        {de
          ? "Bring die Pinselspuren mit. Bleib für den Austausch."
          : "Bring the brush marks. Stay for the exchange."}
      </h2>
    </div>
    <div>
      <p>
        {de
          ? "Teile, was du gemacht hast, vergleiche Pinsel, bitte um Hilfe und beeinflusse, was als Nächstes kommt. Eine verifizierte Discord-Einladung folgt."
          : "Share what you made, compare brushes, ask for help, and influence what comes next. A verified Discord invitation is coming."}
      </p>
      <p class="fine-print">
        {de
          ? "Discord ist ein externer Dienst mit eigenen Bedingungen und Datenschutzregeln. Die App verbindet sich nicht mit Discord; offizieller Support erfolgt per E-Mail."
          : "Discord is a third-party service with its own terms and privacy policy. The app does not connect to Discord; official support is by email."}
      </p>
    </div>
  </section>

  <section class="final-cta section-space halftone-surface">
    <p class="eyebrow">Cozy Paint Studio</p>
    <h2>{de ? "Mach die erste Linie." : "Make the first mark."}</h2>
    <p>
      {de
        ? "Cozy Paint Studio kommt zuerst über den Microsoft Store zu Windows."
        : "Cozy Paint Studio is coming first to Windows through the Microsoft Store."}
    </p>
    <div class="action-row">
      <ReleaseAction {locale} />
    </div>
  </section>
</BaseLayout>
