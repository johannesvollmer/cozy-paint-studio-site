{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    ".astro/**",
    ".npm-cache/**",
    ".pnpm-store/**",
    "docs/TECHNICAL_PLAN.md",
    "docs/brief.md",
    "dist/**",
    "node_modules/**",
    "public/fonts/**",
    "src/**/*.astro"
  ],
  "printWidth": 100,
  "proseWrap": "preserve",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false
}
