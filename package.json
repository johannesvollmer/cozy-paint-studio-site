{
  "name": "cozy-paint-studio-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "check": "astro check",
    "format": "oxfmt . && prettier --write \"src/**/*.astro\"",
    "format:check": "oxfmt --check . && prettier --check \"src/**/*.astro\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "optimize:hero-video": "node scripts/optimize-videos.mjs apple-hero",
    "optimize:videos": "node scripts/optimize-videos.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "test:browser": "pnpm run build && node ./node_modules/@playwright/test/cli.js test",
    "test:links": "node scripts/check-links.mjs",
    "test:performance": "lhci autorun --config=lighthouserc.cjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run check && pnpm run validate:content && pnpm run test && pnpm run test:browser && pnpm run test:links && pnpm run validate:release",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/iosevka-charon-mono": "5.3.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "ffmpeg-static": "^5.3.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "ffmpeg-static"
    ]
  }
}
