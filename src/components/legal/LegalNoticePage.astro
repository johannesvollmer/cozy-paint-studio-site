---
import LegalLayout from "../../layouts/LegalLayout.astro";
import { SUPPORT_EMAIL, ADDRESS, type Locale } from "../../config/site";
import { useTranslations } from "../../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const page = useTranslations(locale).pages.legalNotice;
const de = locale === "de";
---

<LegalLayout
  {locale}
  route="legalNotice"
  title={page.title}
  description={page.description}
  heading={page.heading}
  intro={page.intro}
>
  <section>
    <h2>
      {de ? "Anbieter und für Inhalte verantwortlich" : "Provider and responsible for content"}
    </h2>
    <address>
      <strong>{ADDRESS}</strong>
      <br />
      <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>
    </address>
  </section>
  <section>
    <h2>{de ? "Kontakt" : "Contact"}</h2>
    <p>
      {de ? "Elektronische Anfragen:" : "Electronic enquiries:"}{" "}
      <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>
    </p>
  </section>
  <p class="legal-review-note">
    {de
      ? "Register-, Steuer-, Aufsichts- oder Berufsangaben werden nur ergänzt, wenn sie tatsächlich anwendbar sind."
      : "Register, tax, supervisory, or professional details will be added only if they actually apply."}
  </p>
</LegalLayout>
