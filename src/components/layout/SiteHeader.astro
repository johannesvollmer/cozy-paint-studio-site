---
import type { Locale } from "../../config/site";
import { alternateLocale, routeFor, type RouteKey } from "../../i18n/routes";
import { useTranslations } from "../../i18n";
import ReleaseAction from "../ui/ReleaseAction.astro";
import { landingSections } from "../landing/sections";

interface Props {
  locale: Locale;
  route: RouteKey;
}

const { locale, route } = Astro.props;
const t = useTranslations(locale);
const otherLocale = alternateLocale(locale);
---

<header class="site-header halftone-surface">
  <div class="site-brand">
    <a class="brand-icon" href={routeFor("home", locale)} aria-label="Cozy Paint Studio">
      <img src="/favicon.svg" alt="" width="177" height="178" />
    </a>
    <a
      class="wordmark"
      href={routeFor("home", locale)}
      aria-current={route === "home" ? "page" : undefined}
    >
      Cozy Paint Studio
    </a>
  </div>
  <nav aria-label={t.navigationLabel}>
    {route === "home" ? (
      landingSections.map(({ id, label }) => (
        <a href={`${routeFor("home", locale)}#${id}`} data-scroll-link>
          {t.landingNav[label]}
        </a>
      ))
    ) : (
      <>
        <a
          href={routeFor("support", locale)}
          aria-current={route === "support" ? "page" : undefined}
        >
          {t.nav.support}
        </a>
        <a
          href={routeFor("privacy", locale)}
          aria-current={route === "privacy" ? "page" : undefined}
        >
          {t.nav.privacy}
        </a>
        <a
          href={routeFor("legalNotice", locale)}
          aria-current={route === "legalNotice" ? "page" : undefined}
        >
          {t.nav.legalNotice}
        </a>
      </>
    )}
  </nav>
  <a
    class="language-switch"
    href={routeFor(route, otherLocale)}
    lang={otherLocale}
    hreflang={otherLocale}
    aria-label={`${t.languageSwitchLabel} — ${t.nav[route]}`}
  >
    {otherLocale.toUpperCase()}
  </a>
  <ReleaseAction {locale} />
</header>

<script>
  import { getActiveSectionIndex } from "../../scripts/active-section";

  const header = document.querySelector<HTMLElement>(".site-header");
  const wordmark = header?.querySelector<HTMLAnchorElement>(".wordmark");
  const sectionLinks = Array.from(
    header?.querySelectorAll<HTMLAnchorElement>("[data-scroll-link]") ?? [],
  );
  const sections = sectionLinks.flatMap((link) => {
    const section = document.querySelector<HTMLElement>(
      `#${CSS.escape(decodeURIComponent(link.hash.slice(1)))}`,
    );
    return section ? [{ link, section }] : [];
  });

  if (header && wordmark && sections.length > 0) {
    let frame = 0;
    const fragmentTarget = () => sections.find(({ link }) => link.hash === window.location.hash);
    // Keep an explicit destination aligned while layout settles. User scrolling
    // releases it; the underline always comes from actual geometry.
    let anchorTarget = fragmentTarget();

    const updateHeaderClearance = () => {
      // Native scrolling rounds to CSS pixels. Use one integer boundary for
      // both scroll-padding and active-section selection.
      const clearance = Math.ceil(header.getBoundingClientRect().bottom + 24);
      document.documentElement.style.setProperty("--header-clearance", `${clearance}px`);
      return clearance;
    };

    const updateCurrentSection = () => {
      frame = 0;
      const readingLine = updateHeaderClearance();
      const activeIndex = getActiveSectionIndex(
        sections.map(({ section }) => section.getBoundingClientRect().top),
        readingLine,
      );
      const current = activeIndex >= 0 ? sections[activeIndex] : undefined;

      if (current) wordmark.removeAttribute("aria-current");
      else wordmark.setAttribute("aria-current", "page");
      sectionLinks.forEach((link) => {
        const isCurrent = link === current?.link;
        if (isCurrent) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    };

    const scheduleUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(updateCurrentSection);
    };

    const alignFragment = (behavior: ScrollBehavior) => {
      if (!anchorTarget) return;
      updateHeaderClearance();
      anchorTarget.section.scrollIntoView({ behavior, block: "start" });
      scheduleUpdate();
    };

    // Native links still own navigation, focus, smooth scrolling, and history.
    sections.forEach((target) =>
      target.link.addEventListener("click", (event) => {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.ctrlKey ||
          event.metaKey ||
          event.shiftKey ||
          event.altKey
        )
          return;
        anchorTarget = target;
        updateHeaderClearance();
      }),
    );
    window.addEventListener("hashchange", () => {
      anchorTarget = fragmentTarget();
      window.requestAnimationFrame(() => alignFragment("auto"));
    });

    const releaseAnchor = () => {
      anchorTarget = undefined;
    };
    (["pointerdown", "touchstart", "wheel", "keydown"] as const).forEach((event) =>
      window.addEventListener(event, releaseAnchor, { passive: true }),
    );
    const loaded = new Promise<void>((resolve) => {
      if (document.readyState === "complete") resolve();
      else window.addEventListener("load", () => resolve(), { once: true });
    });
    // Awaiting load at module scope would prevent that event from firing.
    // oxlint-disable-next-line unicorn/prefer-top-level-await
    void Promise.all([loaded, document.fonts.ready]).then(() => {
      window.requestAnimationFrame(() => alignFragment("instant"));
    });

    const headerResizeObserver = new ResizeObserver(() => {
      alignFragment("instant");
      scheduleUpdate();
    });
    headerResizeObserver.observe(header);
    // Content/font/image changes can move section boundaries without a scroll.
    sections.forEach(({ section }) => headerResizeObserver.observe(section));
    const main = document.querySelector("main");
    if (main) headerResizeObserver.observe(main);
    updateCurrentSection();
    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener("resize", scheduleUpdate);
  }
</script>
